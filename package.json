{
  "name": "w3c-offline-html-validator",
  "displayName": "W3C Offline HTML Validator",
  "description": "A VSCode extension for offline HTML validation using W3C standards.",
  "version": "0.0.16",
  "icon": "icon.jpg",
  "engines": {
    "vscode": "^1.93.0"
  },
  "repository": "https://github.com/fgmnts/w3c-offline-html-validator",
  "publisher": "fgmnts",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onSave"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "htmlValidator.toggleValidation",
        "title": "Toggle HTML Validation"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "HTML Validator Settings",
      "properties": {
        "htmlValidator.vnuExecutable": {
          "type": "string",
          "default": "",
          "description": "Path to the vnu executable file."
        },
        "htmlValidator.showErrorMessages": {
          "type": "boolean",
          "default": true,
          "description": "Show error messages."
        },
        "htmlValidator.showWarningMessages": {
          "type": "boolean",
          "default": true,
          "description": "Show warning messages."
        },
        "htmlValidator.showOkMessages": {
          "type": "boolean",
          "default": true,
          "description": "Show messages when validation passes."
        },
        "htmlValidator.autoOpenProblems": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Problems pane when there are validation errors."
        },
        "htmlValidator.noStream": {
          "type": "boolean",
          "default": false,
          "description": "VNU option: Forces all documents to be be parsed in buffered mode instead of streaming mode (causes some parse errors to be treated as non-fatal document errors instead of as fatal document errors)."
        },
        "htmlValidator.noLangDetect": {
          "type": "boolean",
          "default": false,
          "description": "VNU option: Disables language detection, so that documents are not checked for missing or mislabeled html[lang] attributes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.1",
    "typescript": "^5.5.4",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
